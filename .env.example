# ==============================================================================
# DASMO-OFFICE: Automated YouTube Shorts AI Factory - Environment Variables
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="DASMO Office - YouTube Shorts Factory"
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production

# PostgreSQL Database
POSTGRES_USER=dasmo_user
POSTGRES_PASSWORD=dasmo_secure_password
POSTGRES_DB=dasmo_db
POSTGRES_HOST=dasmo-db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://dasmo_user:dasmo_secure_password@dasmo-db:5432/dasmo_db
DATABASE_URL_SYNC=postgresql+psycopg2://dasmo_user:dasmo_secure_password@dasmo-db:5432/dasmo_db

# Redis & Celery
REDIS_HOST=dasmo-redis
REDIS_PORT=6379
REDIS_URL=redis://dasmo-redis:6379/0
CELERY_BROKER_URL=redis://dasmo-redis:6379/0
CELERY_RESULT_BACKEND=redis://dasmo-redis:6379/0

# Storage & Media Volume
MEDIA_DIR=/media

# Voice TTS Settings (edge-tts)
DEFAULT_TTS_VOICE=es-MX-JorgeNeural
DEFAULT_TTS_RATE=+10%

# AI Services & External APIs
GEMINI_API_KEY=your_gemini_api_key_here
PEXELS_API_KEY=your_pexels_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
OPENAI_API_KEY=your_openai_api_key_for_whisper_here
REPLICATE_API_TOKEN=your_replicate_token_here

# YouTube Data API v3 (OAuth 2.0)
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="DASMO Office Dashboard"
